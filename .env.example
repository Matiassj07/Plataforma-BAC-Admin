# ============================================================
# SUPABASE — Obligatorias
# ============================================================
# Supabase > Project Settings > API > URL
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Supabase > Project Settings > API > anon (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase > Project Settings > API > service_role (secret)
# Solo se usa en el servidor para crear/eliminar usuarios.
# NUNCA exponerla al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================
# IA — Opcional (análisis con IA en expediente)
# ============================================================
# Clave del proveedor de IA
AI_API_KEY=sk-...
# Proveedor: "openai" o "anthropic"
AI_PROVIDER=openai
# Modelo (ej: gpt-4o, claude-sonnet-4-20250514)
AI_MODEL=gpt-4o
# URL base personalizada (opcional)
# AI_BASE_URL=https://api.openai.com/v1/chat/completions

# ============================================================
# URL DEL SITIO — Necesaria para OAuth callbacks
# ============================================================
# En desarrollo: http://localhost:3001
# En producción: https://tu-dominio.com
# Si no se define, usa VERCEL_URL automáticamente en Vercel.
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# ============================================================
# ALMACENAMIENTO — Microsoft OneDrive / SharePoint (Opcional)
# ============================================================
# Crear en: https://portal.azure.com > App registrations
# Redirect URI a registrar en Azure: {SITE_URL}/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=tu-client-id-de-azure
MICROSOFT_CLIENT_SECRET=tu-client-secret-de-azure
